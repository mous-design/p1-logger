#!/usr/bin/env bash
set -euo pipefail

# Run from the script's own directory, so `.env` and the relative paths
# below (target/, systemd/) work regardless of the caller's working
# directory. `cd` resolves $PWD to an absolute path either way, even
# given a relative dirname.
cd "$(dirname "$0")"

PI_TARGET="aarch64-unknown-linux-gnu"
PI_HOST=
PI_USER=
DEPLOY_PATH=
RETENTION_DAYS=
if [ -f .env ]; then
    . .env
fi
if [ -z "$DEPLOY_PATH" ]; then
    DEPLOY_PATH="/home/$PI_USER/bin/p1-logger"
fi
usage() {
    cat <<EOF
Usage:
  ./run <file>          Run p1-logger against <file> (device path or plain file)
  ./run build-frontend  fetch the dashboard fonts if missing, then npm install +
                        build the p1-web dashboard (frontend/dist)
  ./run build-dev       cargo build (debug, native)
  ./run build-release   cargo build --release (native)
  ./run build-pi        build-frontend, then cross-compile release build for
                        the Pi ($PI_TARGET) -- p1-web embeds frontend/dist at
                        compile time, so it must exist first
  ./run deploy          build-pi, then scp all three binaries + the systemd
                        units (p1-logger, p1-web) + the cron.d template to $PI_HOST
  ./run view-log <type> [-f]
                        Show recent logs from $PI_HOST via journalctl.
                        <type> is one of: p1-logger, p1-web, p1-aggregate
                        -f follows (like tail -f), Ctrl-C to stop.
  ./run help            Show this usage
EOF
}

# General Sans may be used freely (ITF Free Font License), but not
# redistributed -- so the .woff2 files stay out of the repo, and a build
# fetches them straight from Fontshare instead, only when any is missing.
# The weights must match the @font-face rules in frontend/src/App.scss.
FONT_DIR="frontend/public/fonts"
FONT_WEIGHTS="Regular Medium Semibold Bold"
fetch_fonts() {
    local weight missing=
    for weight in $FONT_WEIGHTS; do
        [ -f "$FONT_DIR/GeneralSans-$weight.woff2" ] || missing=1
    done
    if [ -z "$missing" ]; then
        return
    fi
    echo "Fetching General Sans from Fontshare..."
    local tmp
    tmp="$(mktemp -d)"
    curl -sSfL -o "$tmp/general-sans.zip" "https://api.fontshare.com/v2/fonts/download/general-sans"
    mkdir -p "$FONT_DIR"
    # -j drops the zip's internal folders; a changed zip layout fails
    # loudly here ("filename not matched") instead of silently building
    # with fallback fonts.
    for weight in $FONT_WEIGHTS; do
        unzip -qjo "$tmp/general-sans.zip" "GeneralSans_Complete/Fonts/WEB/fonts/GeneralSans-$weight.woff2" -d "$FONT_DIR"
    done
    rm -rf "$tmp"
}

case "${1:-help}" in
    help | -h | --help)
        usage
        ;;
    build-frontend)
        fetch_fonts
        (cd frontend && npm install && npm run build)
        ;;
    build-dev)
        cargo build
        ;;
    build-release)
        cargo build --release
        ;;
    build-pi)
        "$0" build-frontend
        cross build --release --target "$PI_TARGET"
        ;;
    deploy)
        if [ -z "$PI_HOST" ] || [ -z "$PI_USER" ]; then
            echo "error: PI_HOST and PI_USER must be set in .env" >&2
            exit 1
        fi
        "$0" build-pi
        # /home/$PI_USER/bin must exist before scp can land the binaries in
        # it; /home/$PI_USER/p1-data doesn't need the same treatment, the
        # daemon creates that itself on first start.
        ssh "$PI_HOST" "mkdir -p /home/$PI_USER/bin"
        # Upload to a temp name, then rename into place: overwriting a
        # binary that's currently executing (the daemon, or a cron-invoked
        # aggregate run) fails with ETXTBSY. A rename only swaps the
        # directory entry, so anything mid-run (on the old inode) is
        # untouched.
        for bin in p1-web p1-logger p1-aggregate; do
            scp "target/$PI_TARGET/release/$bin" "$PI_HOST:/home/$PI_USER/bin/$bin.new"
            ssh "$PI_HOST" "mv /home/$PI_USER/bin/$bin.new /home/$PI_USER/bin/$bin"
        done
        # systemd/p1-{logger,web}.service and cron.d/p1-aggregate are
        # templates committed to the repo (placeholders, no username/paths);
        # fill in the real user from .env only at deploy time, into
        # throwaway rendered copies.
        for unit in p1-logger p1-web; do
            rendered_service="$(mktemp)"
            sed "s|__PI_USER__|$PI_USER|g" "systemd/$unit.service" > "$rendered_service"
            scp "$rendered_service" "$PI_HOST:/home/$PI_USER/$unit.service"
            rm -f "$rendered_service"
        done

        # RETENTION_DAYS is optional -- unset means the cron line gets no
        # --retention-days flag at all, i.e. processed/ is never pruned.
        retention_flag=
        if [ -n "$RETENTION_DAYS" ]; then
            retention_flag=" --retention-days $RETENTION_DAYS"
        fi
        rendered_cron="$(mktemp)"
        sed -e "s|__PI_USER__|$PI_USER|g" -e "s|__RETENTION_FLAG__|$retention_flag|g" cron.d/p1-aggregate > "$rendered_cron"
        scp "$rendered_cron" "$PI_HOST:/home/$PI_USER/p1-aggregate.cron"
        rm -f "$rendered_cron"
        cat <<EOF

Binaries + unit files + cron template deployed. One-time install on $PI_HOST (needs sudo):
  sudo mv /home/$PI_USER/p1-logger.service /etc/systemd/system/p1-logger.service
  sudo mv /home/$PI_USER/p1-web.service /etc/systemd/system/p1-web.service
  sudo systemctl daemon-reload
  sudo systemctl enable --now p1-logger
  sudo systemctl enable --now p1-web
  sudo mv /home/$PI_USER/p1-aggregate.cron /etc/cron.d/p1-aggregate
  sudo chown root:root /etc/cron.d/p1-aggregate
  sudo chmod 644 /etc/cron.d/p1-aggregate
After that, redeploys just need: sudo systemctl restart p1-logger p1-web
(cron picks up an updated p1-aggregate binary on its own next run, no reload needed)
EOF
        ;;
    view-log)
        if [ -z "$PI_HOST" ]; then
            echo "error: PI_HOST must be set in .env" >&2
            exit 1
        fi
        follow_flag=
        if [ "${3:-}" = "-f" ]; then
            follow_flag="-f"
        fi
        # -t allocates a pseudo-terminal: without it, Ctrl-C on a following
        # (-f) journalctl doesn't reliably reach the remote process.
        case "${2:-}" in
            # p1-logger/p1-web run under systemd, so -u (unit) picks up
            # everything associated with that service, including
            # start/stop/restart events -- not just what it itself logged.
            p1-logger | p1-web)
                ssh -t "$PI_HOST" "journalctl -u $2 -n 200 --no-pager $follow_flag"
                ;;
            # p1-aggregate is a cron job, not a systemd unit, so there's no
            # unit to filter by -- -t (syslog identifier) is what all three
            # binaries are tagged with, set in logging::init_logging.
            p1-aggregate)
                ssh -t "$PI_HOST" "journalctl -t p1-aggregate -n 200 --no-pager $follow_flag"
                ;;
            *)
                echo "error: unknown log type '${2:-}'" >&2
                echo "usage: ./run view-log <p1-logger|p1-web|p1-aggregate> [-f]" >&2
                exit 1
                ;;
        esac
        ;;
    *)
        cargo run --quiet -- "$@"
        ;;
esac
